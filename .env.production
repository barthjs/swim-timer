# Every variable can also be read from a file by appending _FILE to its name, e.g. APP_SECRET_FILE=/run/secrets/app_secret.

APP_NAME=Swim-Timer
APP_ENV=production
APP_LANGUAGE=en
APP_SECRET=

LOG_LEVEL=warn
LOG_CHANNEL=stdout
LOG_PATH=/data/logs
LOG_FORMAT=json
LOG_MAX_SIZE_MB=100
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

SERVER_HOST=*
SERVER_PORT=8080
SERVER_TRUSTED_PROXIES="127.0.0.0/8,::1/128"
SERVER_CORS_ALLOWED_ORIGINS=
SERVER_CORS_ALLOW_CREDENTIALS=false
SERVER_SSL_ENABLED=false
SERVER_SSL_CERT_FILE=
SERVER_SSL_KEY_FILE=

STORAGE_DRIVER=local
STORAGE_PATH=/data/storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_PATH_STYLE=true

THEME_PRIMARY=
THEME_SECONDARY=
THEME_SUCCESS=
THEME_INFO=
THEME_WARNING=
THEME_ERROR=
THEME_NEUTRAL=

TIMING_SERIAL_PORT=
TIMING_BAUD_RATE=9600
TIMING_POOL_LENGTH=50
TIMING_SIMULATE_EVENT=0
TIMING_REPLAY_PATH=
TIMING_RECORDING=true

WEBHOOK_ALLOWED_NETWORKS=

CONFIG_FILE=/data/config.yaml

PUID=1000
PGID=1000
