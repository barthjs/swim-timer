[Unit]
Description=Swim-Timer
After=network.target

[Service]
Type=simple
User=swim-timer
Group=swim-timer
SupplementaryGroups=dialout
WorkingDirectory=/var/lib/swim-timer
LogsDirectory=swim-timer
Environment=SWIM_TIMER_SUPERVISED=1
ExecStart=/usr/bin/swim-timer
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
