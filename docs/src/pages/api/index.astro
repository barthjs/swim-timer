---
// The API reference renders without the layout of Starlight, since Scalar brings its own.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>API Reference</title>
  </head>
  <body>
    <div id="api-reference"></div>
    <script>
      import '../../api/main.ts';
    </script>
  </body>
</html>

<style is:global>
  /* Scalar fills the page, so the default margin of the browser would show as a frame */
  body {
    margin: 0;
  }
</style>
