{
  "name": "docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "run-s \"build-only {@}\" type-check --",
    "preview": "astro preview",
    "build-only": "astro build && node scripts/postbuild.ts dist",
    "type-check": "astro check",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "test:lint": "run-s \"test:lint:*\"",
    "test:lint:oxlint": "oxlint .",
    "test:lint:eslint": "eslint .",
    "test:format": "prettier --check .",
    "test:unit": "vitest run --coverage",
    "test:app-links": "node scripts/check-app-links.ts dist",
    "test": "run-s test:lint test:format test:unit test:app-links"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "^0.43.1",
    "@scalar/api-reference": "^1.82.1",
    "astro": "^7.4.13",
    "starlight-links-validator": "^0.27.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-oxlint": "^1.94.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.1.1",
    "npm-run-all2": "^9.1.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vfile": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
