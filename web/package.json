{
  "name": "web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s \"build-only {@}\" type-check --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "test:lint": "run-s \"test:lint:*\"",
    "test:lint:oxlint": "oxlint .",
    "test:lint:eslint": "eslint .",
    "test:format": "prettier --check .",
    "test:unit": "vitest run --coverage",
    "test": "run-s test:lint test:format test:unit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@iconify-json/lucide": "^1.2.158",
    "@nuxt/ui": "^4.13.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node24": "^24.0.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-oxlint": "^1.94.0",
    "eslint-plugin-vue": "~10.12.1",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.1.1",
    "npm-run-all2": "^9.1.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
