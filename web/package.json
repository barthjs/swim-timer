{
  "name": "web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s \"build-only {@}\" type-check --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "test:lint": "run-s \"test:lint:*\"",
    "test:lint:oxlint": "oxlint .",
    "test:lint:eslint": "eslint .",
    "test:format": "prettier --check src/",
    "test:unit": "vitest run",
    "test": "run-s test:lint test:format test:unit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/ui": "^4.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.88.0",
    "eslint-plugin-vue": "~10.11.1",
    "happy-dom": "^21.0.3",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.1.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.11"
  },
  "allowScripts": {
    "esbuild": true,
    "vue-demi": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
